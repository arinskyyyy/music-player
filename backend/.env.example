# Database Configuration (PostgreSQL)
# Local Homebrew install: use a dedicated role + database (created once):
#   psql -U "$USER" -d postgres -c "CREATE ROLE syncroom LOGIN PASSWORD 'syncroom'"
#   psql -U "$USER" -d postgres -c "CREATE DATABASE syncroom OWNER syncroom"
DATABASE_URL=postgresql://syncroom:syncroom@localhost:5432/syncroom

# Security & Authentication
JWT_SECRET=super_secret_pixel_syncroom_jwt_key_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Client Origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
